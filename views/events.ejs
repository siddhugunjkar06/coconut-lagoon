<%- include('partials/head', { title: 'Events & Celebrations' }) %>
<%- include('partials/navbar') %>

<div class="page-hero" style="padding-top:72px">
  <div class="page-hero-bg" style="background-image:url('https://images.trvl-media.com/lodging/120000000/119770000/119762000/119761966/e7aae43a.jpg')"></div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content">
    <div class="page-hero-label">Celebrations & Events</div>
    <h1 class="page-hero-title">Unforgettable <em>Moments</em></h1>
  </div>
</div>

<section class="section" style="background:var(--bg)">
  <div class="container">
    <div style="text-align:center;max-width:640px;margin:0 auto 60px" class="reveal">
      <div class="section-label" style="justify-content:center">Event Packages</div>
      <h2 class="section-title">Host Your <em>Celebration</em><br>With Us</h2>
      <p class="section-sub" style="margin:16px auto 0">From intimate birthdays to grand weddings, Coconut Lagoon Agro Resort provides the perfect natural backdrop for every special occasion.</p>
    </div>

    <!-- Event Packages -->
    <%
    const defaultEvents = [
      { _id:'wed', title:'Wedding Celebration', category:'wedding', capacity:200, priceFrom:150000, duration:'1-2 days', description:'Create your dream wedding surrounded by nature. Lush greenery, romantic ambience, and our dedicated team handle every detail.', includes:['Decorated venue','Catering for all guests','Photography coordination','Accommodation for couple','Floral décor','Sound system & lighting'] },
      { _id:'bday', title:'Birthday Bash', category:'birthday', capacity:50, priceFrom:25000, duration:'Half / Full day', description:'Celebrate your special day with a private party at our resort — pool access, DJ, and customised arrangements just for you.', includes:['Private party area','Customised cake','Pool & rain dance access','DJ and sound','Decorations','Dedicated host'] },
      { _id:'corp', title:'Corporate Retreat', category:'corporate', capacity:100, priceFrom:50000, duration:'1-3 days', description:'Team-building retreats and corporate events with modern AV facilities, outdoor activities, and full board accommodation.', includes:['Conference hall with AV','Accommodation','All meals','Team activities','Business centre','Airport transfers'] },
      { _id:'fam', title:'Family Get-together', category:'private', capacity:80, priceFrom:40000, duration:'1-2 days', description:'Gather your loved ones for a memorable family reunion with exclusive resort access, BBQ, bonfire and activities.', includes:['Exclusive lawn area','BBQ setup','Pool access for all','Bonfire & music','Full meals','Accommodation packages'] },
    ];
    const displayEvents = (events && events.length > 0) ? events : defaultEvents;
    const catIcons = { wedding:'fas fa-ring', birthday:'fas fa-birthday-cake', corporate:'fas fa-briefcase', festival:'fas fa-music', private:'fas fa-users', other:'fas fa-star' };
    %>

    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:28px;margin-bottom:80px">
      <% displayEvents.forEach((ev, i) => { %>
      <div class="reveal" style="background:var(--white);border:1px solid var(--line);border-radius:20px;overflow:hidden;transition:all 0.35s ease" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 20px 60px rgba(0,0,0,0.1)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
        <div style="background:linear-gradient(135deg,var(--accent) 0%, var(--accent2) 100%);padding:32px;display:flex;align-items:center;gap:20px">
          <div style="width:56px;height:56px;border-radius:14px;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;color:white;font-size:24px">
            <i class="<%= catIcons[ev.category] || 'fas fa-star' %>"></i>
          </div>
          <div>
            <div style="font-size:9px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(255,255,255,0.6);margin-bottom:4px"><%= ev.category.toUpperCase() %></div>
            <div style="font-family:'Cormorant Garamond',serif;font-size:24px;color:white;font-weight:400"><%= ev.title %></div>
          </div>
        </div>
        <div style="padding:28px">
          <p style="font-size:13px;color:var(--ink2);line-height:1.7;margin-bottom:20px"><%= ev.description %></p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px">
            <div style="background:var(--card);padding:12px;border-radius:10px">
              <div style="font-size:10px;color:var(--ink3);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:2px">Capacity</div>
              <div style="font-size:16px;font-weight:500;color:var(--ink)">Up to <%= ev.capacity %></div>
            </div>
            <div style="background:var(--card);padding:12px;border-radius:10px">
              <div style="font-size:10px;color:var(--ink3);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:2px">Starting From</div>
              <div style="font-size:16px;font-weight:500;color:var(--accent)">₹<%= (ev.priceFrom||0).toLocaleString('en-IN') %></div>
            </div>
          </div>
          <% if(ev.includes && ev.includes.length > 0) { %>
          <div style="margin-bottom:20px">
            <div style="font-size:11px;font-weight:500;color:var(--ink);margin-bottom:10px;text-transform:uppercase;letter-spacing:0.08em">What's Included</div>
            <div style="display:flex;flex-direction:column;gap:6px">
              <% ev.includes.slice(0,4).forEach(inc => { %>
              <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink2)">
                <i class="fas fa-check-circle" style="color:var(--accent);font-size:11px"></i><%= inc %>
              </div>
              <% }) %>
              <% if(ev.includes.length > 4) { %><div style="font-size:11px;color:var(--ink3)">+<%= ev.includes.length - 4 %> more inclusions...</div><% } %>
            </div>
          </div>
          <% } %>
          <a href="#enquiry-form" onclick="document.getElementById('eventNameInput').value='<%= ev.title %>'" class="btn-primary" style="width:100%;justify-content:center;display:flex">
            Enquire Now <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      </div>
      <% }) %>
    </div>

    <!-- EVENT BOOKING FORM -->
    <div id="enquiry-form" style="background:var(--accent);border-radius:24px;padding:56px;max-width:800px;margin:0 auto" class="reveal">
      <div style="text-align:center;margin-bottom:40px">
        <div style="font-family:'Pinyon Script',cursive;font-size:28px;color:var(--gold2);margin-bottom:8px">Let's plan together</div>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:36px;color:white;font-weight:400;margin-bottom:10px">Send An Enquiry</h2>
        <p style="font-size:13px;color:rgba(255,255,255,0.65)">Our events team will review your request and confirm within 24 hours</p>
        <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.1);padding:8px 16px;border-radius:100px;margin-top:8px">
          <i class="fas fa-info-circle" style="color:var(--gold2);font-size:12px"></i>
          <span style="font-size:11px;color:rgba(255,255,255,0.7)">All event bookings are confirmed by our admin team</span>
        </div>
      </div>

      <% if(success) { %>
      <div style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.3);border-radius:12px;padding:20px;margin-bottom:28px;color:white;font-size:14px;text-align:center">
        <i class="fas fa-check-circle" style="color:var(--gold2);margin-right:8px"></i> <%- success %>
      </div>
      <% } %>
      <% if(error) { %>
      <div style="background:rgba(220,53,69,0.2);border:1px solid rgba(220,53,69,0.4);border-radius:12px;padding:16px;margin-bottom:28px;color:white;font-size:13px">
        <i class="fas fa-exclamation-circle" style="margin-right:8px"></i> <%= error %>
      </div>
      <% } %>

      <form method="POST" action="/events/book" style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <input type="hidden" name="eventId" value="">
        <div style="grid-column:span 2">
          <label style="font-size:10px;color:rgba(255,255,255,0.6);letter-spacing:0.12em;text-transform:uppercase;display:block;margin-bottom:6px">Event Type</label>
          <select name="eventName" id="eventNameInput" style="width:100%;padding:13px 16px;border-radius:10px;border:none;font-size:14px;background:rgba(255,255,255,0.12);color:white;outline:none;appearance:none;cursor:pointer">
            <option value="" style="background:#2a5c3a">Select Event Type</option>
            <% displayEvents.forEach(ev => { %><option value="<%= ev.title %>" style="background:#2a5c3a"><%= ev.title %></option><% }) %>
            <option value="Custom Event" style="background:#2a5c3a">Other / Custom Event</option>
          </select>
        </div>
        <div>
          <label style="font-size:10px;color:rgba(255,255,255,0.6);letter-spacing:0.12em;text-transform:uppercase;display:block;margin-bottom:6px">Your Name *</label>
          <input type="text" name="name" required placeholder="Full name" style="width:100%;padding:13px 16px;border-radius:10px;border:none;font-size:14px;background:rgba(255,255,255,0.12);color:white;outline:none" class="evt-input">
        </div>
        <div>
          <label style="font-size:10px;color:rgba(255,255,255,0.6);letter-spacing:0.12em;text-transform:uppercase;display:block;margin-bottom:6px">Phone *</label>
          <input type="tel" name="phone" required placeholder="+91 00000 00000" style="width:100%;padding:13px 16px;border-radius:10px;border:none;font-size:14px;background:rgba(255,255,255,0.12);color:white;outline:none" class="evt-input">
        </div>
        <div>
          <label style="font-size:10px;color:rgba(255,255,255,0.6);letter-spacing:0.12em;text-transform:uppercase;display:block;margin-bottom:6px">Email *</label>
          <input type="email" name="email" required placeholder="your@email.com" style="width:100%;padding:13px 16px;border-radius:10px;border:none;font-size:14px;background:rgba(255,255,255,0.12);color:white;outline:none" class="evt-input">
        </div>
        <div>
          <label style="font-size:10px;color:rgba(255,255,255,0.6);letter-spacing:0.12em;text-transform:uppercase;display:block;margin-bottom:6px">Expected Guests</label>
          <input type="number" name="guests" placeholder="Number of guests" min="1" style="width:100%;padding:13px 16px;border-radius:10px;border:none;font-size:14px;background:rgba(255,255,255,0.12);color:white;outline:none" class="evt-input">
        </div>
        <div>
          <label style="font-size:10px;color:rgba(255,255,255,0.6);letter-spacing:0.12em;text-transform:uppercase;display:block;margin-bottom:6px">Preferred Date *</label>
          <input type="date" name="eventDate" required style="width:100%;padding:13px 16px;border-radius:10px;border:none;font-size:14px;background:rgba(255,255,255,0.12);color:white;outline:none;color-scheme:dark" class="evt-input">
        </div>
        <div style="grid-column:span 2">
          <label style="font-size:10px;color:rgba(255,255,255,0.6);letter-spacing:0.12em;text-transform:uppercase;display:block;margin-bottom:6px">Additional Requirements</label>
          <textarea name="message" rows="3" placeholder="Tell us about your vision — theme, requirements, special arrangements..." style="width:100%;padding:13px 16px;border-radius:10px;border:none;font-size:14px;background:rgba(255,255,255,0.12);color:white;outline:none;resize:vertical" class="evt-input"></textarea>
        </div>
        <div style="grid-column:span 2">
          <button type="submit" style="width:100%;padding:16px;background:var(--gold);color:white;border:none;border-radius:100px;font-size:12px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;transition:all 0.3s;display:flex;align-items:center;justify-content:center;gap:10px" onmouseenter="this.style.background='#e8b85a'" onmouseleave="this.style.background='var(--gold)'">
            <i class="fas fa-paper-plane"></i> Submit Event Enquiry
          </button>
        </div>
      </form>
      <div style="text-align:center;margin-top:16px;font-size:12px;color:rgba(255,255,255,0.4)">
        <i class="fas fa-clock"></i> Our team responds within 24 hours · <a href="tel:+917775947728" style="color:rgba(255,255,255,0.6)">+91 77759 47728</a>
      </div>
    </div>
  </div>
</section>

<style>
.evt-input::placeholder { color: rgba(255,255,255,0.4); }
.evt-input:focus { background: rgba(255,255,255,0.2) !important; box-shadow: 0 0 0 2px rgba(255,255,255,0.3); }
</style>

<a href="https://wa.me/917775947728" target="_blank" class="whatsapp-float"><i class="fab fa-whatsapp"></i></a>
<%- include('partials/footer') %>
