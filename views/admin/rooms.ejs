<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Rooms — Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/css/admin.css">
</head><body>
<div class="admin-layout">
  <%- include('../partials/admin-sidebar', { page: page, admin: admin }) %>
  <main class="admin-main">
    <div class="admin-topbar">
      <div><div class="topbar-title">Rooms</div><div class="topbar-breadcrumb">Manage resort rooms and suites</div></div>
      <a href="/admin/rooms/new" class="topbar-btn topbar-btn-primary"><i class="fas fa-plus"></i> Add Room</a>
    </div>
    <div class="admin-content">
      <% if(success && success.length > 0) { %><div class="adm-alert adm-alert-success"><i class="fas fa-check-circle"></i> <%= success %></div><% } %>
      <div class="data-card">
        <table class="adm-table">
          <thead><tr><th>Image</th><th>Room Name</th><th>Type</th><th>Price</th><th>Capacity</th><th>Status</th><th>Featured</th><th>Actions</th></tr></thead>
          <tbody>
          <% if(!rooms || rooms.length === 0) { %><tr><td colspan="8"><div class="empty-state"><i class="fas fa-door-open" style="display:block;font-size:32px;margin-bottom:12px"></i>No rooms yet. <a href="/admin/rooms/new" style="color:var(--adm-accent)">Add first room</a></div></td></tr><% } %>
          <% (rooms || []).forEach(r => { %>
          <tr>
            <td><% if(r.images && r.images[0]) { %><img src="<%= r.images[0].url %>" class="room-img-thumb"><% } else { %><div style="width:90px;height:70px;background:#f5f5f5;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#ccc"><i class="fas fa-image"></i></div><% } %></td>
            <td style="font-weight:500"><%= r.name %></td>
            <td><span style="font-size:11px;background:#f0f0f0;padding:3px 10px;border-radius:100px"><%= r.type %></span></td>
            <td style="font-weight:500;color:var(--adm-accent)">₹<%= r.price.toLocaleString('en-IN') %></td>
            <td><i class="fas fa-user" style="font-size:10px;color:#999"></i> <%= r.capacity %></td>
            <td><span class="badge-status <%= r.available ? 'badge-confirmed' : 'badge-cancelled' %>"><%= r.available ? 'Available' : 'Unavailable' %></span></td>
            <td><%= r.featured ? '<i class="fas fa-star" style="color:#f9a825"></i>' : '<i class="far fa-star" style="color:#ccc"></i>' %></td>
            <td style="display:flex;gap:8px;flex-wrap:wrap">
              <a href="/admin/rooms/<%= r._id %>/edit" class="btn-adm btn-adm-outline btn-adm-sm"><i class="fas fa-edit"></i></a>
              <button class="btn-adm btn-adm-danger btn-adm-sm delete-btn" data-url="/admin/rooms/<%= r._id %>"><i class="fas fa-trash"></i></button>
            </td>
          </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
<script>
document.querySelectorAll('.delete-btn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    e.preventDefault();
    if (!confirm('Delete this room?')) return;
    const res = await fetch(btn.dataset.url, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) btn.closest('tr').remove();
  });
});
</script>
</body></html>
