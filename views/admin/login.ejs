<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Login — Coconut Lagoon Resort</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/css/admin.css">
<style>
body { display:flex; align-items:center; justify-content:center; min-height:100vh;
  background: linear-gradient(135deg, #0f1623 0%, #1a2638 50%, #0f1623 100%); }
.login-wrap { width: 420px; }
.login-card { background: white; border-radius: 20px; padding: 48px; box-shadow: 0 30px 80px rgba(0,0,0,0.4); }
.login-logo { text-align: center; margin-bottom: 36px; }
.login-logo-icon { width: 56px; height: 56px; border-radius: 14px; background: var(--adm-accent); display: flex; align-items: center; justify-content: center; color: white; font-size: 24px; margin: 0 auto 12px; }
.login-logo-name { font-family: 'Cormorant Garamond', serif; font-size: 22px; color: var(--adm-ink); }
.login-logo-sub { font-size: 11px; color: var(--adm-ink2); letter-spacing: 0.1em; }
.login-title { font-size: 13px; font-weight: 500; color: var(--adm-ink2); margin-bottom: 28px; text-align: center; text-transform: uppercase; letter-spacing: 0.1em; }
.login-form-group { margin-bottom: 18px; }
.login-label { display: block; font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--adm-ink2); margin-bottom: 8px; }
.login-input { width: 100%; padding: 13px 16px; border: 1.5px solid #e8eaf0; border-radius: 10px; font-size: 14px; outline: none; transition: all 0.2s; }
.login-input:focus { border-color: var(--adm-accent); box-shadow: 0 0 0 3px rgba(42,92,58,0.1); }
.login-input-group { position: relative; }
.login-input-group .login-input { padding-left: 42px; }
.login-input-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #aaa; font-size: 14px; }
.login-btn { width: 100%; padding: 14px; background: var(--adm-accent); color: white; border-radius: 10px; font-size: 13px; font-weight: 500; letter-spacing: 0.05em; transition: all 0.2s; margin-top: 8px; }
.login-btn:hover { background: var(--adm-accent2); transform: translateY(-1px); }
.login-back { text-align: center; margin-top: 20px; font-size: 12px; color: rgba(255,255,255,0.5); }
.login-back a { color: rgba(255,255,255,0.75); }
</style>
</head>
<body>
<div class="login-wrap">
  <div class="login-card">
    <div class="login-logo">
      <div class="login-logo-icon"><i class="fas fa-leaf"></i></div>
      <div class="login-logo-name">Coconut Lagoon</div>
      <div class="login-logo-sub">Resort Management System</div>
    </div>
    <div class="login-title">Admin Sign In</div>
    <% if(error && error.length > 0) { %><div class="adm-alert adm-alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>
    <form method="POST" action="/admin/login">
      <div class="login-form-group">
        <label class="login-label">Email Address</label>
        <div class="login-input-group">
          <i class="fas fa-envelope login-input-icon"></i>
          <input class="login-input" type="email" name="email" placeholder="admin@coconutlagoon.com" required autofocus>
        </div>
      </div>
      <div class="login-form-group">
        <label class="login-label">Password</label>
        <div class="login-input-group">
          <i class="fas fa-lock login-input-icon"></i>
          <input class="login-input" type="password" name="password" placeholder="••••••••" required>
        </div>
      </div>
      <button type="submit" class="login-btn"><i class="fas fa-sign-in-alt"></i> Sign In to Dashboard</button>
    </form>
  </div>
  <div class="login-back"><a href="/"><i class="fas fa-arrow-left"></i> Back to Resort Website</a></div>
</div>
</body>
</html>
