<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Reviews — Admin</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/css/admin.css">
</head><body>
<div class="admin-layout">
  <%- include('../partials/admin-sidebar', { page: page, admin: admin }) %>
  <main class="admin-main">
    <div class="admin-topbar">
      <div><div class="topbar-title">Reviews</div><div class="topbar-breadcrumb">Manage guest reviews (<%= reviews.length %> total)</div></div>
    </div>
    <div class="admin-content">
      <div class="data-card">
        <table class="adm-table">
          <thead><tr><th>Guest</th><th>Rating</th><th>Review</th><th>Source</th><th>Date</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody>
          <% if(!reviews.length) { %><tr><td colspan="7"><div class="empty-state"><i class="fas fa-star" style="display:block;font-size:32px;margin-bottom:12px"></i>No reviews yet</div></td></tr><% } %>
          <% reviews.forEach(r => { %>
          <tr>
            <td><div style="font-weight:500"><%= r.name %></div><% if(r.email) { %><div style="font-size:11px;color:#999"><%= r.email %></div><% } %></td>
            <td><span style="color:#f9a825"><%= '★'.repeat(r.rating) %></span><span style="color:#ddd"><%= '☆'.repeat(5-r.rating) %></span></td>
            <td style="max-width:300px"><div style="font-size:12px;color:var(--adm-ink2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= r.review %></div></td>
            <td><span style="font-size:11px;background:#f5f5f5;padding:3px 8px;border-radius:100px"><%= r.source %></span></td>
            <td style="font-size:12px;color:#999"><%= moment(r.createdAt).format('DD MMM YYYY') %></td>
            <td>
              <div style="display:flex;gap:6px">
                <span class="badge-status <%= r.approved ? 'badge-confirmed' : 'badge-pending' %>"><%= r.approved ? 'Approved' : 'Pending' %></span>
                <% if(r.featured) { %><span class="badge-status" style="background:#fff3e0;color:#e65100"><i class="fas fa-star" style="font-size:10px"></i> Featured</span><% } %>
              </div>
            </td>
            <td style="display:flex;gap:6px">
              <% if(!r.approved) { %><button class="btn-adm btn-adm-primary btn-adm-sm approve-btn" data-id="<%= r._id %>"><i class="fas fa-check"></i></button><% } %>
              <button class="btn-adm btn-adm-outline btn-adm-sm feature-btn" data-id="<%= r._id %>" title="Toggle featured"><i class="fas fa-star"></i></button>
              <button class="btn-adm btn-adm-danger btn-adm-sm delete-btn" data-url="/admin/reviews/<%= r._id %>"><i class="fas fa-trash"></i></button>
            </td>
          </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
<script>
document.querySelectorAll('.approve-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    const res = await fetch('/admin/reviews/' + btn.dataset.id + '/approve', { method: 'POST' });
    const d = await res.json();
    if (d.success) { btn.remove(); location.reload(); }
  });
});
document.querySelectorAll('.feature-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    await fetch('/admin/reviews/' + btn.dataset.id + '/feature', { method: 'POST' });
    location.reload();
  });
});
document.querySelectorAll('.delete-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    if (!confirm('Delete review?')) return;
    const res = await fetch(btn.dataset.url, { method: 'DELETE' });
    const d = await res.json();
    if (d.success) btn.closest('tr').remove();
  });
});
</script>
</body></html>
