<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %>Admin · Coconut Lagoon Resort</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/css/admin.css">
<%- typeof extraStyles !== 'undefined' ? extraStyles : '' %>
</head>
<body>
<div class="admin-layout">
  <!-- SIDEBAR -->
  <aside class="admin-sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-logo">
        <div class="sidebar-logo-icon"><i class="fas fa-leaf"></i></div>
        <div>
          <div class="sidebar-logo-name">Coconut Lagoon</div>
          <div class="sidebar-logo-sub">Resort Admin</div>
        </div>
      </div>
      <div class="sidebar-admin-badge">
        <i class="fas fa-user-shield"></i>
        <%= typeof admin !== 'undefined' ? admin.name : 'Admin' %>
      </div>
    </div>
    <nav class="sidebar-nav">
      <div class="sidebar-section-label">Main</div>
      <a href="/admin/dashboard" class="sidebar-link <%= page === 'dashboard' ? 'active' : '' %>"><i class="fas fa-chart-pie"></i> Dashboard</a>
      <a href="/admin/bookings" class="sidebar-link <%= page === 'bookings' ? 'active' : '' %>"><i class="fas fa-calendar-alt"></i> Bookings</a>
      <div class="sidebar-section-label">Content</div>
      <a href="/admin/rooms" class="sidebar-link <%= page === 'rooms' ? 'active' : '' %>"><i class="fas fa-door-open"></i> Rooms</a>
      <a href="/admin/gallery" class="sidebar-link <%= page === 'gallery' ? 'active' : '' %>"><i class="fas fa-images"></i> Gallery</a>
      <a href="/admin/reviews" class="sidebar-link <%= page === 'reviews' ? 'active' : '' %>"><i class="fas fa-star"></i> Reviews</a>
      <div class="sidebar-section-label">Communication</div>
      <a href="/admin/contacts" class="sidebar-link <%= page === 'contacts' ? 'active' : '' %>"><i class="fas fa-envelope"></i> Messages</a>
      <div class="sidebar-section-label">Account</div>
      <a href="/admin/settings" class="sidebar-link <%= page === 'settings' ? 'active' : '' %>"><i class="fas fa-cog"></i> Settings</a>
      <a href="/" target="_blank" class="sidebar-link"><i class="fas fa-external-link-alt"></i> View Website</a>
      <a href="/admin/logout" class="sidebar-link" style="color:rgba(220,53,69,0.7);margin-top:8px"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </nav>
  </aside>
  <!-- MAIN -->
  <main class="admin-main">
    <%- body %>
  </main>
</div>
<script>
document.querySelectorAll('.delete-btn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    e.preventDefault();
    if (!confirm('Are you sure you want to delete this?')) return;
    const url = btn.dataset.url;
    const row = btn.closest('tr') || btn.closest('.admin-gallery-item');
    try {
      const res = await fetch(url, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
      const data = await res.json();
      if (data.success && row) row.remove();
      else alert('Delete failed');
    } catch(err) { alert('Error deleting'); }
  });
});
</script>
</body>
</html>
