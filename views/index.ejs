      <div class="loc-item"><div class="loc-icon"><i class="fas fa-phone-alt"></i></div><div><div class="loc-label">Phone</div><div class="loc-value">+91 77759 47728</div></div></div>
      <div class="loc-item"><div class="loc-icon"><i class="fas fa-envelope"></i></div><div><div class="loc-label">Email</div><div class="loc-value">coconutlagoon53@gmail.com</div></div></div>
